# yt-dlp 산출물 — 미디어 + .part/.ytdl 임시파일 + 썸네일 전부. 다른 머신에서는 classification.json 으로 --restore.
downloads/

# yt-dlp --download-archive 기록 — 머신 로컬 상태. 커밋하면 다른 머신에서 전부 "이미 받음"으로 스킵된다.
archive_*.txt

# 안전망: downloads/ 밖으로 떨어져도 미디어는 안 올라가게
*.m4a
*.mp4
*.mkv
*.webm
*.opus
*.part

# python / macOS
__pycache__/
.DS_Store

# 편집기용 산출물 (fcpxml/srt/description/커버) — 절대경로가 들어가고 매니페스트에서 재생성됨
build/

# GarageBand 프로젝트 (패키지 폴더, 용량 큼) — 프로젝트 폴더 안에 두되 커밋하지 않음. 믹스는 Share > Export 로 build/daw/mix.wav 에
*.band

# 효과음 라이브러리 — 오디오는 무시, 출처·라이선스 매니페스트만 커밋 (.claude/skills/sfx-collect)
sfx/*
!sfx/manifest.json
# 스킬 평가 작업 폴더
.claude/skills/*-workspace/
# 서브에이전트 worktree
.claude/worktrees/
# 프로젝트 폴더의 효과음 심볼릭 링크 (sfx.json 대로 sfx.py link 가 재생성)
*/sfx/
